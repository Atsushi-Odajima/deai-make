# Mingle API configuration. Copy to `.env` and adjust as needed.

# HTTP port the API listens on.
PORT=4000

# Secret used to sign JWTs. CHANGE THIS in any non-local environment.
JWT_SECRET=mingle-dev-secret-change-me
JWT_EXPIRES_IN=30d

# Comma-separated list of web origins allowed by CORS (web client + preview).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Where the SQLite database file lives.
DB_PATH=./data/mingle.db

# Public base URL of this API. Used to build absolute media (avatar) URLs that
# clients — including the future iOS app — can load directly.
PUBLIC_URL=http://localhost:4000
